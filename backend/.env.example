# =============================================================================
# FETALAI PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env and provide secrets before running in production.
# NEVER commit .env with real secrets to version control!
# =============================================================================

# Server Environment (development | testing | production)
ENVIRONMENT=production

# Server Binding
API_HOST=0.0.0.0
PORT=8000
API_PORT=8000

# Frontend URL & Allowed CORS Origins
# MUST use https:// in production. Comma-separated for multiple origins.
FRONTEND_URL=https://fetal-anomaly-detection.onrender.com
FRONTEND_ORIGINS=https://fetalai-frontend.onrender.com

# JWT Secret & Token Security
# MUST be at least 32 characters, cryptographically random, never default.
JWT_SECRET_KEY=generate_a_secure_32_plus_char_random_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Two-Factor Authentication (OTP)
LOGIN_OTP_ENABLED=false

# PostgreSQL Database Connection
# Connection pooling and SSL are automatically enforced.
DATABASE_URL=postgresql://user:password@your-postgres-host.neon.tech:5432/neondb?sslmode=require
POSTGRES_HOST=your-postgres-host.neon.tech
POSTGRES_PORT=5432
POSTGRES_DB=fetalai
POSTGRES_USER=fetalai_user
POSTGRES_PASSWORD=your_secure_db_password

# Database Connection Pool Settings (Optimized for low-RAM ~512MB environments)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Brevo (Sendinblue) HTTPS Email API
# Used for password resets and clinical report dispatches over port 443.
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=FetalAI Clinical AI Platform

# In-Memory Rate Limiting (Protects low-RAM instances from DoS and credential stuffing)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_INFERENCE_PER_MINUTE=20
RATE_LIMIT_DEFAULT_PER_MINUTE=60

# Observability & Metrics
METRICS_ENABLED=true

# Worker Lifecycle & Microservice Routing
# Set WORKER_AUTO_START=false when running independent Docker worker containers
WORKER_AUTO_START=false
WORKER_IDLE_TIMEOUT_SECONDS=300
WORKER_STARTUP_TIMEOUT_SECONDS=60
WORKER_REAPER_INTERVAL_SECONDS=5
WORKER_HEALTH_TIMEOUT_SECONDS=5
WORKER_MAX_RETRIES=1
MAX_UPLOAD_SIZE_BYTES=15728640

# Internal Docker Worker URLs (Optional override for custom microservice hosts)
WORKER_PLANE_URL=http://plane-worker:8100
WORKER_SPINE_URL=http://spine-worker:8101
WORKER_BRAIN_URL=http://brain-worker:8102
WORKER_LUNG_URL=http://lung-worker:8103
WORKER_BONE_URL=http://bone-worker:8105
WORKER_PLACENTA_URL=http://placenta-worker:8106
WORKER_FACE_URL=http://face-worker:8107
WORKER_HEART_URL=http://heart-worker:8108

# Security Headers & HSTS
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=true
